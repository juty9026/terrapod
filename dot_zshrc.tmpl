# ============================================
# Terminal Configuration
# ============================================

# mise
if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi

# Fastfetch
# The greeting belongs to the first shell of a session. Zellij panes and nested
# shells run this file too, and the dev layout opens five panes at once; `c`
# reprints it on demand.
if [[ -z "${ZELLIJ:-}" && "${SHLVL:-1}" -le 1 ]] && command -v fastfetch &>/dev/null; then
  fastfetch
fi

# Per-user zsh completions
# Vendor CLI installers (sentry-cli and others) append this same fpath entry
# to the end of .zshrc so their completions load. Declaring it here makes
# those appends redundant instead of drift, and puts it ahead of every
# compinit rebuild below so completions dropped there register on first use.
# A missing directory is not an error: zsh silently skips it on fpath.
fpath=("$HOME/.local/share/zsh/site-functions" $fpath)

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(git)
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# Starship prompt
if command -v starship &>/dev/null; then
  eval "$(starship init zsh)"
fi

# ============================================
# Zinit plugin manager
# ============================================
zinit_script="$HOME/.local/share/zinit/zinit.git/zinit.zsh"

if [[ -r "$zinit_script" ]]; then
  source "$zinit_script"
  autoload -Uz _zinit
  (( ${+_comps} )) && _comps[zinit]=_zinit

  zinit light zdharma-continuum/fast-syntax-highlighting
  zinit light zsh-users/zsh-autosuggestions
  zinit light zsh-users/zsh-completions

  # zsh-completions only extends fpath, and oh-my-zsh.sh already ran compinit
  # against the shorter fpath above. Rebuild the table so the new completion
  # directories actually register; sharing Oh My Zsh's dump keeps it to one
  # cache file.
  #
  # The security flag matches the one oh-my-zsh.sh just used, so the rebuilt
  # table holds the same directories as the one it replaces. It also has to be
  # there at all: bare `compinit` asks what to do about an insecure directory,
  # and a shell that cannot answer aborts compinit and loses the whole table.
  autoload -Uz compinit
  if [[ "${ZSH_DISABLE_COMPFIX:-}" == true ]]; then
    compinit -u -d "${ZSH_COMPDUMP:-${ZDOTDIR:-$HOME}/.zcompdump}"
  else
    compinit -i -d "${ZSH_COMPDUMP:-${ZDOTDIR:-$HOME}/.zcompdump}"
  fi
fi
unset zinit_script

# ============================================
# SCM Breeze
# ============================================
if [[ -z "$CLAUDECODE" ]]; then
  [ -s "$HOME/.scm_breeze/scm_breeze.sh" ] && source "$HOME/.scm_breeze/scm_breeze.sh"
fi

# ============================================
# Modern CLI aliases
# ============================================
# 1Password Service Account Helpers are shared by both machine profiles.
# Recovery-oriented startup also works before the module has been applied.
if [[ -r "$HOME/.config/zsh/1password-service-accounts.zsh" ]]; then
  source "$HOME/.config/zsh/1password-service-accounts.zsh"
fi

alias ls="lsd"
alias ll="lsd -la"
alias lt="lsd --tree"
alias cat="bat"
alias find="fd"
alias grep="rg"
alias top="btop"
alias df="duf"
alias du="dust"
alias vim="nvim"
alias vi="nvim"
alias lg="lazygit"
alias ..="cd .."
alias ...="cd ../.."
alias zj="zellij"

unalias c 2>/dev/null

function c() {
  clear
  if command -v fastfetch &>/dev/null; then
    fastfetch
  fi
}

function zja() {
  local session="${1:-${PWD:t}}"
  zellij attach "$session"
}

{{ if (default false (get . "enableDevelopmentWorkspace")) -}}
alias zd="zellij --layout dev"
function zdac() {
  local session="${1:-${PWD:t}}"
  zellij --layout dev attach --create "$session"
}

{{ end -}}

# ============================================
# fzf + zoxide
# ============================================
if command -v fzf &>/dev/null; then
  source <(fzf --zsh)
fi

if command -v zoxide &>/dev/null; then
  unalias zi 2>/dev/null
  eval "$(zoxide init zsh)"
fi

# ============================================
# Tool launcher
# ============================================
function tools() {
  local cmds=(
    "btop:🖥️  System monitor"
    "lazygit:📦 Git UI"
    "duf:💾 Disk usage"
    "dust:📁 Folder sizes"
    "fastfetch:ℹ️  System info"
  )
  local selected=$(printf '%s\n' "${cmds[@]}" | fzf --delimiter=: --with-nth=2 --height=40% --reverse --border --prompt="Select a tool: ")
  local cmd="${selected%%:*}"
  [[ -n "$cmd" ]] && eval "$cmd"
}

# ============================================
# zoxide
# ============================================
function zr() {
  local dir
  dir=$(zoxide query -l | sort -k2 -rn | fzf)
  [ -n "$dir" ] && z "$dir"
}

function zg() {
  local dir
  dir=$(zoxide query -l | xargs -I {} sh -c 'test -d {}/.git && echo {}' | fzf)
  [ -n "$dir" ] && z "$dir"
}

# ============================================
# Git worktree
# ============================================
function wcd() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "This directory is not a Git repository."
    return 1
  fi

  if ! command -v fzf >/dev/null 2>&1; then
    echo "fzf is not installed. Run mise install or brew install fzf."
    return 1
  fi

  # One porcelain record per worktree, blank-line separated. Bare records have
  # no checkout and prunable records point at a directory that is already
  # gone, so neither is offered: cd would fail on both. The display column is
  # built here rather than pasted from `git worktree list` so the two never
  # drift out of step when records are dropped.
  local selected
  selected="$(
    git worktree list --porcelain | awk '
      /^worktree / { path = substr($0, 10); head = ""; ref = ""; locked = ""; skip = 0; next }
      /^HEAD /     { head = substr($0, 6, 7); next }
      /^branch /   { ref = substr($0, 8); sub(/^refs\/heads\//, "", ref); ref = "[" ref "]"; next }
      /^detached$/ { ref = "(detached HEAD)"; next }
      /^locked/    { locked = " locked"; next }
      /^bare$/ || /^prunable/ { skip = 1; next }
      /^$/ {
        if (path != "" && !skip) {
          n++; paths[n] = path; rows[n] = head " " ref locked
          if (length(path) > width) width = length(path)
        }
        path = ""
      }
      END {
        for (i = 1; i <= n; i++) printf "%s\t%-" width "s  %s\n", paths[i], paths[i], rows[i]
      }
    ' | fzf --delimiter=$'\t' --with-nth=2.. --height=40% --reverse --ansi
  )"

  [ -n "$selected" ] || return 0
  cd "${selected%%$'\t'*}"
}
