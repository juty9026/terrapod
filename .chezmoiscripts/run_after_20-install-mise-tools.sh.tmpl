{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/sh
set -eu

{{ include "dot_local/lib/terrapod/homebrew-prefix.sh" }}

{{ include "dot_local/lib/terrapod/homebrew-paths.sh" }}

{{ include "dot_local/lib/terrapod/install-warnings.sh" }}

{{ include "dot_local/lib/terrapod/install-warning-script.sh" }}

declare_install_warning_category mise-tools "mise tool install needs attention"

standard_mise_path() {
  terrapod_standard_homebrew_mise_path "{{ .chezmoi.os }}"
}

mise_bin="$(standard_mise_path || true)"
if [ -z "$mise_bin" ] || [ ! -x "$mise_bin" ]; then
  fail_install_warning_category "Install the mandatory Homebrew core bundle, then rerun tpod apply."
fi

if ! "$mise_bin" install --yes -C "$HOME"; then
  note_failed_install_warning_item "mise install"
fi

if "$mise_bin" exec --yes -C "$HOME" -- sh -c 'command -v corepack' >/dev/null 2>&1; then
  if ! "$mise_bin" exec --yes -C "$HOME" -- corepack enable; then
    note_failed_install_warning_item "corepack enable"
  fi
fi

finish_install_warning_category "Failed step(s): %s. Review mise output, fix tool installation issues, then rerun tpod apply. If mise aqua resolution hit GitHub API rate limits, export a temporary GITHUB_TOKEN or run gh auth login before rerunning."
{{- end }}
