{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/sh
set -eu

{{ include "dot_local/lib/terrapod/homebrew-prefix.sh" }}

{{ include "dot_local/lib/terrapod/homebrew-paths.sh" }}

{{ include "dot_local/lib/terrapod/install-warnings.sh" }}

{{ include "dot_local/lib/terrapod/install-warning-script.sh" }}

AI_CLI_WARNING_CATEGORY=optional-ai-cli-tools
declare_install_warning_category "$AI_CLI_WARNING_CATEGORY" "Optional AI CLI tool install needs attention"

{{ if not (and (eq .chezmoi.os "darwin") (or (default false (get . "enableAiCliTools")) (default false (get . "enableDevelopmentWorkspace")))) }}
finish_install_warning_category
{{ else }}
{{ include "dot_local/lib/terrapod/homebrew-bundle.sh" }}

ai_cli_brewfile=
ai_cli_failures_file=
claude_code_installer=

CLAUDE_CODE_CANONICAL_EXECUTABLE="$HOME/.local/bin/claude"
CLAUDE_CODE_INSTALLER_URL=https://claude.ai/install.sh

cleanup_ai_cli_install() {
  [ -z "$ai_cli_brewfile" ] || rm -f "$ai_cli_brewfile"
  [ -z "$ai_cli_failures_file" ] || rm -f "$ai_cli_failures_file"
  [ -z "$claude_code_installer" ] || rm -f "$claude_code_installer"
}

trap cleanup_ai_cli_install EXIT HUP INT TERM

setup_brew_environment() {
  brew_bin="$(terrapod_homebrew_find_standard_brew "{{ .chezmoi.os }}" || true)"
  if [ -z "$brew_bin" ]; then
    echo "Mandatory standard-prefix Homebrew is unavailable for the Optional AI Tool Stack." >&2
    return 1
  fi
  terrapod_homebrew_load_shellenv "$brew_bin"
}

install_ai_cli_bundle() {
  setup_brew_environment || return 1
  ai_cli_brewfile="$(mktemp "${TMPDIR:-/tmp}/terrapod-ai-cli-brewfile.XXXXXX")" || return 1
  cat >"$ai_cli_brewfile" <<'BREWFILE'
{{ includeTemplate "Brewfile.ai-cli-tools.tmpl" . }}
BREWFILE

  ai_cli_failures_file="$(mktemp "${TMPDIR:-/tmp}/terrapod-ai-cli-failures.XXXXXX")" || return 1
  terrapod_homebrew_bundle_run "$brew_bin" "$ai_cli_brewfile" "$ai_cli_failures_file"
}

install_claude_code() {
  # The vendor installer always downloads the latest build, so running it on an
  # existing install would upgrade Claude Code on every apply. Terrapod restores
  # a missing install only; Claude Code's own updater owns version freshness.
  [ ! -x "$CLAUDE_CODE_CANONICAL_EXECUTABLE" ] || return 0

  echo "Installing Claude Code..."
  claude_code_installer="$(mktemp "${TMPDIR:-/tmp}/terrapod-claude-code-installer.XXXXXX")" || return 1
  curl -fsSL "$CLAUDE_CODE_INSTALLER_URL" -o "$claude_code_installer" || return 1

  # bash, not sh: the vendor script declares #!/bin/bash and uses [[ =~ ]],
  # BASH_REMATCH, and $'...' quoting.
  # </dev/null: the vendor script ends by running `claude install`, which has no
  # unattended flag and can wait on a terminal UI. First-run apply runs in an
  # interactive terminal, so an install that prompts would stall it.
  bash "$claude_code_installer" </dev/null || return 1

  [ -x "$CLAUDE_CODE_CANONICAL_EXECUTABLE" ]
}

if ! install_ai_cli_bundle; then
  if [ -n "$ai_cli_failures_file" ] && [ -s "$ai_cli_failures_file" ]; then
    ai_cli_tab="$(printf '\t')"
    while IFS="$ai_cli_tab" read -r ai_cli_kind ai_cli_name ai_cli_group <&3; do
      note_failed_install_warning_item "$ai_cli_name"
    done 3<"$ai_cli_failures_file"
  else
    note_failed_install_warning_item "Homebrew bundle"
  fi
fi
install_claude_code || note_failed_install_warning_item "Claude Code"

finish_install_warning_category "Failed: %s. Review the installer output and network access, then rerun tpod apply."
{{ end }}
{{- end }}
