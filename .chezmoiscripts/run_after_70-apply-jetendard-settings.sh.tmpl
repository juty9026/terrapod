{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

{{ include "dot_local/lib/terrapod/install-warnings.sh" }}

{{ include "dot_local/lib/terrapod/install-warning-script.sh" }}

declare_install_warning_category jetendard-settings "Jetendard app settings need attention"

settings_helper="{{ .chezmoi.sourceDir }}/dot_local/lib/terrapod/executable_jetendard-settings"

if ! command -v python3 >/dev/null 2>&1; then
  fail_install_warning_category "Restore Python, quit Orca, then rerun tpod apply."
fi

settings_status=0
python3 "$settings_helper" apply || settings_status="$?"
case "$settings_status" in
  0)
    finish_install_warning_category
    ;;
  2)
    declare_install_warning_category jetendard-settings "Jetendard Orca setting is deferred"
    fail_install_warning_category "Quit Orca, then rerun tpod apply."
    ;;
  *)
    fail_install_warning_category "Repair the reported Zed or Orca settings file, quit Orca, then rerun tpod apply."
    ;;
esac
{{- end }}
