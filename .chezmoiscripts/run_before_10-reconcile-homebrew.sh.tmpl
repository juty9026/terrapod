{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
{{- $enableMacosAppGroups := and
  (eq .chezmoi.os "darwin")
  (eq (includeTemplate "any-macos-app-group-enabled" . | trim) "true")
-}}
#!/bin/sh
set -eu

{{ include "dot_local/lib/terrapod/homebrew-prefix.sh" }}

{{ include "dot_local/lib/terrapod/homebrew-paths.sh" }}

{{ include "dot_local/lib/terrapod/install-warnings.sh" }}

{{ include "dot_local/lib/terrapod/install-warning-script.sh" }}

{{ if $enableMacosAppGroups -}}
{{ include "dot_local/lib/terrapod/config-toml.sh" }}
{{ end -}}

{{ include "dot_local/lib/terrapod/homebrew-bundle.sh" }}

terrapod_homebrew_core_permission_guidance() {
  prefix="$(brew --prefix 2>/dev/null || true)"

  if [ -n "$prefix" ] && [ -e "$prefix" ] && [ ! -w "$prefix" ]; then
    printf '%s\n' "Homebrew prefix is not writable: $prefix. Fix Homebrew permissions for your user or ask the prefix owner/admin; avoid broad ownership changes."
    return
  fi

  if [ -n "$prefix" ]; then
    printf '%s\n' "If this was a permissions failure, check Homebrew permissions under $prefix without broad ownership changes."
    return
  fi

  printf '%s\n' "If this was a permissions failure, check Homebrew prefix permissions without broad ownership changes."
}

homebrew_arch="$(terrapod_homebrew_hardware_arch "{{ .chezmoi.os }}" || true)"
{{ if eq .chezmoi.os "linux" -}}
case "$homebrew_arch" in
  x86_64|aarch64) ;;
  *)
    printf '%s\n' "Unsupported CPU architecture: $homebrew_arch. Supported architectures: x86_64, aarch64." >&2
    exit 1
    ;;
esac
{{ end -}}

brew_bin="$(terrapod_homebrew_find_standard_brew "{{ .chezmoi.os }}" || true)"

if [ -z "$brew_bin" ]; then
{{ if eq .chezmoi.os "linux" -}}
  homebrew_space_path=/home/linuxbrew
  homebrew_space_parent="$homebrew_space_path"
  while [ ! -e "$homebrew_space_parent" ] && [ "$homebrew_space_parent" != / ]; do
    homebrew_space_parent="$(dirname "$homebrew_space_parent")"
  done

  if homebrew_df_output="$(df -Pk "$homebrew_space_parent" 2>/dev/null)"; then
    homebrew_available_kb="$(printf '%s\n' "$homebrew_df_output" | awk 'NR == 2 { print $4; exit }')"
    case "$homebrew_available_kb" in
      ''|*[!0-9]*) ;;
      *)
        if [ "$homebrew_available_kb" -lt 3145728 ]; then
          printf '%s\n' \
            "Warning: less than 3 GiB is available for $homebrew_space_path; Homebrew installation will continue." >&2
        fi
        ;;
    esac
  fi
{{ end -}}
  echo "Installing Homebrew..."
  homebrew_installer="$(mktemp "${TMPDIR:-/tmp}/terrapod-homebrew-install.XXXXXX")"
  if ! curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$homebrew_installer"; then
    rm -f "$homebrew_installer"
    mark_install_warning \
      homebrew-core \
      "Homebrew core install needs attention" \
      "Install Homebrew from https://brew.sh, then rerun tpod apply."
    exit_after_install_warning
  fi
  if ! NONINTERACTIVE=1 /bin/bash "$homebrew_installer"; then
    rm -f "$homebrew_installer"
    mark_install_warning \
      homebrew-core \
      "Homebrew core install needs attention" \
      "Install Homebrew from https://brew.sh, then rerun tpod apply."
    exit_after_install_warning
  fi
  rm -f "$homebrew_installer"
  brew_bin="$(terrapod_homebrew_find_standard_brew "{{ .chezmoi.os }}" || true)"
fi

if [ -z "$brew_bin" ]; then
  echo "Homebrew install finished, but brew was not found." >&2
  mark_install_warning \
    homebrew-core \
    "Homebrew core install needs attention" \
    "Install Homebrew from https://brew.sh, then rerun tpod apply."
  exit_after_install_warning
fi

if ! terrapod_homebrew_load_shellenv "$brew_bin"; then
  mark_install_warning \
    homebrew-core \
    "Homebrew core install needs attention" \
    "Fix Homebrew shellenv, then rerun tpod apply."
  exit_after_install_warning
else
  brew analytics off >/dev/null 2>&1 || true
fi

core_brewfile="{{ .chezmoi.sourceDir }}/Brewfile"

if [ -f "$core_brewfile" ]; then
  if terrapod_homebrew_bundle_step brew "$core_brewfile" "$homebrew_arch"; then
    clear_install_warning homebrew-core
  else
    permission_guidance="$(terrapod_homebrew_core_permission_guidance)"
    mark_install_warning \
      homebrew-core \
      "Homebrew core install needs attention" \
      "Review Homebrew core bundle output, fix package access, then rerun tpod apply. Failed: $TERRAPOD_HOMEBREW_BUNDLE_FAILURE_DETAIL. $permission_guidance"
    continue_after_core_install_warning
  fi
fi

{{ if $enableMacosAppGroups -}}
desktop_brewfile="$(mktemp "${TMPDIR:-/tmp}/terrapod-macos-desktop-apps.XXXXXX")"
cleanup_desktop_brewfile() {
  rm -f "$desktop_brewfile"
}
trap cleanup_desktop_brewfile EXIT HUP INT TERM

cat >"$desktop_brewfile" <<'BREWFILE'
{{ includeTemplate "Brewfile.macos-desktop-apps.tmpl" . -}}
BREWFILE

if [ -s "$desktop_brewfile" ]; then
  if terrapod_homebrew_bundle_step brew "$desktop_brewfile" "$homebrew_arch"; then
    clear_install_warning homebrew-desktop-apps
  else
    mark_install_warning \
      homebrew-desktop-apps \
      "Homebrew desktop app install needs attention" \
      "Review Homebrew desktop app bundle output for $TERRAPOD_HOMEBREW_BUNDLE_FAILURE_DETAIL, fix app installation access, then rerun tpod apply."
    exit_after_install_warning
  fi
fi
{{ else -}}
clear_install_warning homebrew-desktop-apps
{{- end }}
{{- end }}
