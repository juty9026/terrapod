{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/bin/sh
set -eu

{{ include "dot_local/lib/terrapod/homebrew-prefix.sh" }}

{{ include "dot_local/lib/terrapod/install-warnings.sh" }}

{{ include "dot_local/lib/terrapod/install-warning-script.sh" }}

failed_gh_extensions=

append_failed_gh_extension() {
  extension="$1"

  if [ -n "$failed_gh_extensions" ]; then
    failed_gh_extensions="$failed_gh_extensions, $extension"
  else
    failed_gh_extensions="$extension"
  fi
}

finish_gh_extensions() {
  if [ -n "$failed_gh_extensions" ]; then
    mark_install_warning \
      gh-extensions \
      "GitHub CLI Extension Set install needs attention" \
      "Failed to install: $failed_gh_extensions. Review gh output, fix authentication or network access, then rerun tpod apply."
    exit_after_install_warning
  fi

  clear_install_warning gh-extensions
}

standard_gh_path() {
  terrapod_standard_homebrew_gh_path "{{ .chezmoi.os }}"
}

gh_bin="$(standard_gh_path || true)"
if [ -z "$gh_bin" ] || [ ! -x "$gh_bin" ]; then
  mark_install_warning \
    gh-extensions \
    "GitHub CLI Extension Set install needs attention" \
    "Install the mandatory Homebrew core bundle, then rerun tpod apply."
  exit_after_install_warning
fi

gh_extension_installed() {
  extension="$1"

  "$gh_bin" extension list 2>/dev/null | awk -v want="$extension" '
    {
      for (i = 1; i <= NF; i++) {
        if ($i == want) {
          found = 1
        }
      }
    }
    END { exit !found }
  '
}

install_gh_extension() {
  extension="$1"

  if gh_extension_installed "$extension"; then
    return 0
  fi

  echo "Installing GitHub CLI extension $extension..."
  "$gh_bin" extension install "$extension"
}

gh_extensions_list="$(mktemp "${TMPDIR:-/tmp}/terrapod-gh-extensions.XXXXXX")"

cleanup_gh_extensions_list() {
  rm -f "$gh_extensions_list"
}

trap cleanup_gh_extensions_list EXIT HUP INT TERM

cat >"$gh_extensions_list" <<'GH_EXTENSIONS'
{{ includeTemplate "gh-extensions.tmpl" . }}
GH_EXTENSIONS

while IFS= read -r declared_extension; do
  case "$declared_extension" in
    ''|'#'*) continue ;;
  esac

  install_gh_extension "$declared_extension" || append_failed_gh_extension "$declared_extension"
done <"$gh_extensions_list"

finish_gh_extensions
{{- end }}
