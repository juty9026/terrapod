# Rendered opt-in macOS Desktop App Stack.
{{ $groupKey := "enableMacosAppGroupTerminalApps" -}}
{{ if default false (get . $groupKey) -}}
# terrapod-macos-app-group: {{ $groupKey }}
cask "ghostty"
cask "font-d2coding"
cask "font-hack-nerd-font"
cask "font-jetbrains-mono-nerd-font"
cask "font-noto-sans-cjk-kr"
{{ end -}}
{{ $groupKey := "enableMacosAppGroupAutomation" -}}
{{ if default false (get . $groupKey) -}}
# terrapod-macos-app-group: {{ $groupKey }}
cask "hammerspoon"
cask "karabiner-elements"
cask "scroll-reverser"
{{ end -}}
{{ $groupKey := "enableMacosAppGroupLauncher" -}}
{{ if default false (get . $groupKey) -}}
# terrapod-macos-app-group: {{ $groupKey }}
cask "raycast"
cask "1password-cli"
{{ end -}}
{{ $groupKey := "enableMacosAppGroupMonitoring" -}}
{{ if default false (get . $groupKey) -}}
# terrapod-macos-app-group: {{ $groupKey }}
cask "istat-menus"
{{ end -}}
{{ $groupKey := "enableMacosAppGroupDevelopmentApps" -}}
{{ if default false (get . $groupKey) -}}
# terrapod-macos-app-group: {{ $groupKey }}
cask "zed"
cask "stablyai/orca/orca", trusted: true
cask "orbstack"
{{ end -}}
{{ $groupKey := "enableMacosAppGroupMobileDev" -}}
{{ if default false (get . $groupKey) -}}
# terrapod-macos-app-group: {{ $groupKey }}
cask "android-studio"
brew "mobile-dev-inc/tap/maestro", trusted: true
{{ end -}}
{{ $groupKey := "enableMacosAppGroupBrowsers" -}}
{{ if default false (get . $groupKey) -}}
# terrapod-macos-app-group: {{ $groupKey }}
cask "aside"
cask "google-chrome"
{{ end -}}
{{ $groupKey := "enableMacosAppGroupAiApps" -}}
{{ if default false (get . $groupKey) -}}
# terrapod-macos-app-group: {{ $groupKey }}
cask "claude"
cask "chatgpt"
cask "google-gemini"
{{ end -}}
